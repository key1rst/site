# Local development configuration example. Keep credentials in your operator environment.
# OIL_DB_PATH=./data/oil.db
# OIL_FILE_PATH=./data/uploads
# OIL_FRONTEND_ORIGIN=http://127.0.0.1:5173
# OIL_COOKIE_SECURE=1
# For a registered profile slug "company-logistics":
# OIL_INTEGRATION_COMPANY_LOGISTICS_URL=https://approved-receiver.example.test/events
# OIL_INTEGRATION_COMPANY_LOGISTICS_TOKEN=<set-in-operator-secret-store>
# The integration worker requires an explicit --send invocation after receiver approval.
